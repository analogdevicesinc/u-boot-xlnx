/dts-v1/;
#include "zynq-7000.dtsi"

/ {
	model = "Zynq Sharkbyte Board";
	compatible = "xlnx,zynq-7000";

	aliases {
		ethernet0 = &gem0;
		serial0 = &uart1;
		spi0 = &qspi;
	};

	memory {
		device_type = "memory";
		reg = <0x0 0x20000000>;
	};

	chosen {
		bootargs = "earlyprintk";
		linux,stdout-path = &uart1;
		stdout-path = &uart1;
	};

	usb_phy0: phy0 {
		compatible = "usb-nop-xceiv";
		#phy-cells = <0>;
	};

};

&qspi {
	status = "okay";
	is-dual = <0>;
	num-cs = <1>;
	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0x0>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <4>;
		spi-max-frequency = <50000000>;
		#address-cells = <1>;
		#size-cells = <1>;
		partition@qspi-golden {
			label = "qspi-golden";
			reg = <0x0 0x40000>; /* 256k */
		};
		partition@qspi-bootrec {
			label = "qspi-bootrec";
			reg = <0x40000 0x20000>; /* 128k */
		};
		partition@qspi-uboot-env {
			label = "qspi-uboot-env";
			reg = <0x100000 0x20000>; /* 128k */
		};
		partition@qspi-nvmfs {
			label = "qspi-nvmfs";
			reg = <0x120000 0xE0000>; /* 1M */
		};
		partition@qspi-boot-a {
			label = "qspi-boot-a";
			reg = <0x200000 0x100000>; /* 1M */
		};
		partition@qspi-boot-b {
			label = "qspi-boot-b";
			reg = <0x300000 0x100000>; /* 1M */
		};
		partition@qspi-app-a {
			label = "qspi-app-a";
			reg = <0x400000 0x1C00000>; /* 28M */
		};
		partition@qspi-app-b {
			label = "qspi-app-b";
			reg = <0x2000000 0x1C00000>; /* 28M */
		};
	};
};

&uart1 {
	status = "okay";
};

&usb0 {
	status = "okay";
	dr_mode = "host";
	usb-phy = <&usb_phy0>;
};
